# Copy to .env and edit, or export these directly before starting the
# controller. Every value has a working default, so none of this is required.

# --- Network ---
# Use 0.0.0.0 to accept connections from real devices on the LAN.
IOT_HOST=127.0.0.1
IOT_PORT=9000
IOT_BACKLOG=32
IOT_RECV_BUFFER_BYTES=4096

# --- Authentication ---
# Shared secret. Must match the token compiled into device firmware.
IOT_AUTH_TOKEN=iot-secret-2026
# How long an unauthenticated peer may stay connected without sending AUTH.
IOT_AUTH_TIMEOUT_SEC=5

# --- Liveness ---
IOT_HEARTBEAT_EVERY_SEC=10
IOT_HEARTBEAT_TIMEOUT_SEC=5

# --- Command delivery ---
IOT_COMMAND_ACK_TIMEOUT_SEC=5
IOT_COMMAND_MAX_RETRIES=3
IOT_COMMAND_RETRY_INTERVAL_SEC=3

# --- Housekeeping ---
IOT_PRUNE_INTERVAL_SEC=60

# --- Output ---
# Set to 1 to disable ANSI colour codes (useful when piping logs to a file).
IOT_NO_COLOR=

# --- Device simulators ---
LED_DEVICE_ID=led1
TEMP_DEVICE_ID=temp1
